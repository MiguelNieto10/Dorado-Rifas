# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube a Git (está en .gitignore).

# --- Firebase (estas SÍ pueden ir en el navegador; empiezan por VITE_) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# --- Quién ve el panel de administrador (nombres de usuario, separados por coma) ---
VITE_ADMIN_USERNAMES=Miguel_NP_10

# --- ePayco (estas NO deben ir al navegador; sin VITE_) ---
# Cuando actives pagos reales, ponlas en Vercel → Settings → Environment Variables.
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=

# --- Firebase Admin (servidor: cambiar claves y, más adelante, ePayco) ---
# En Vercel → Settings → Environment Variables. Sin esto no se puede confirmar "Olvidé mi clave".
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Correo de bienvenida (Gmail o Google Workspace) ---
# El "De:" que ve el jugador. vercel.app NO es un Gmail: para enviar de verdad
# usa un Gmail/Workspace real en SMTP_USER y una contraseña de aplicación.
MAIL_FROM=Administrador@dorado-rifas.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
