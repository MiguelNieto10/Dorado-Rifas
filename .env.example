# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube a Git (está en .gitignore).

# --- Firebase (estas SÍ pueden ir en el navegador; empiezan por VITE_) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# --- Quién ve el panel de administrador (nombres de usuario, separados por coma) ---
VITE_ADMIN_USERNAMES=Miguel_NP_10

# --- Pagos (Nequi; el cobro en la app sigue simulado hasta que actives comprobantes reales) ---
NEQUI_PHONE=

# --- Firebase Admin (servidor: cambiar claves) ---
# En Vercel → Settings → Environment Variables. Sin esto no se puede confirmar "Olvidé mi clave".
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Correo de bienvenida ---
# Sin SMTP_USER y SMTP_PASS en Vercel el correo NO se envía.
# Usa un Gmail real (el de Dorado) y una contraseña de aplicación:
# Google → Cuenta → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
# MAIL_FROM debe ser ese mismo Gmail. Un correo @vercel.app no llega a la bandeja.
MAIL_FROM=tucorreo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
